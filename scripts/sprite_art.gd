extends RefCounted
## Presentation only. Metadata and palettes are generated by art_tools/build_art.py.
## Imported resources first; worker PNG decoding keeps fresh clones usable.
const STATES := {
	"turret": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch"],
	"player": ["idle", "run", "jump", "fall", "land", "dash", "glide", "wall", "hurt", "death", "switch"],
	"walker": ["idle", "move", "windup", "fire", "hurt", "death"],
	"flyer": ["idle", "move", "windup", "fire", "hurt", "death"],
	"laser": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch"],
	"breaker": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch"],
	"builder": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch"],
	"shifter": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch"],
	"enhancer": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch"],
	"guardian": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch", "windup_special", "fire_special"],
	"final": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch", "windup_special", "fire_special"],
	"secret": ["idle", "move", "windup", "fire", "hurt", "death", "windup_switch", "switch", "windup_special", "fire_special"],
}
static var mode_override := ""
static var path_overrides: Dictionary = {}
static var _textures: Dictionary = {}
static var _warnings: Dictionary = {}
static var _metadata: Dictionary = {}
static var _metadata_checked := false
static var _icons: Dictionary = {}
static var image_read_attempts := 0
const LOAD_BUDGET_USEC := 1500
static var _pending: Dictionary = {}
static var _requests: Array[Dictionary] = []
static var _prewarm_started := false
static var upload_serial := 0
static var load_frame_max_usec := 0
static var load_operation_max_usec := 0
static var imported_loads := 0
static var raw_loads := 0

class DecodeJob extends RefCounted:
	var path := ""
	var image: Image
	func run() -> void:
		if not FileAccess.file_exists(path): return
		var bytes := FileAccess.get_file_as_bytes(path)
		if bytes.size()<33 or bytes.slice(0,8)!=PackedByteArray([137,80,78,71,13,10,26,10]): return
		var im := Image.new()
		if im.load_png_from_buffer(bytes) == OK and not im.is_empty(): image = im

static func prewarm() -> void:
	if not enabled() or _prewarm_started: return
	_prewarm_started = true
	var file := FileAccess.open("res://assets/art/manifest.json", FileAccess.READ)
	if file == null: return
	var data = JSON.parse_string(file.get_as_text())
	if not data is Dictionary: return
	for relative: String in data.get("hashes", {}):
		var path := "res://" + relative
		_request(path, path)

static func _request(id: String, resolved: String) -> void:
	var key := id + "|" + resolved
	if _textures.has(key) or _pending.has(key): return
	_pending[key] = {"id": id, "path": resolved, "phase": "queued"}
	_requests.append({"key": key})

static func _raw_request(entry: Dictionary) -> void:
	var job := DecodeJob.new()
	job.path = entry.path
	entry.job = job
	entry.task = WorkerThreadPool.add_task(job.run)
	entry.phase = "raw"
	image_read_attempts += 1

static func _import_available(path: String) -> bool:
	if not ResourceLoader.exists(path): return false
	# In an editor checkout, .import may exist while its cache is absent.
	# Avoid requesting that broken remap; exported packs use ResourceLoader's
	# built-in remapping and do not depend on loose source PNG bytes.
	if OS.has_feature("editor"):
		var config := ConfigFile.new()
		if config.load(path+".import") != OK: return false
		return FileAccess.file_exists(str(config.get_value("remap","path","")))
	return true

static func service_loading() -> void:
	if not enabled(): return
	prewarm()
	var began := Time.get_ticks_usec()
	# Scheduling, completed-resource collection and GPU uploads share one budget.
	# No load_threaded_get / task join is called before its completion check.
	if not _requests.is_empty():
		var entry: Dictionary = _pending[_requests.pop_front().key]
		var op := Time.get_ticks_usec()
		if _import_available(entry.path) and ResourceLoader.load_threaded_request(entry.path, "Texture2D", false) == OK:
			entry.phase = "imported"
		else: _raw_request(entry)
		load_operation_max_usec = maxi(load_operation_max_usec, Time.get_ticks_usec()-op)
	for key: String in _pending.keys():
		if Time.get_ticks_usec()-began >= LOAD_BUDGET_USEC: break
		var entry: Dictionary = _pending[key]
		var result: Texture2D
		var done := false
		var op := Time.get_ticks_usec()
		if entry.phase == "imported":
			var status := ResourceLoader.load_threaded_get_status(entry.path)
			if status == ResourceLoader.THREAD_LOAD_LOADED:
				result = ResourceLoader.load_threaded_get(entry.path) as Texture2D
				if result != null: imported_loads += 1; done = true
				else: _raw_request(entry)
			elif status in [ResourceLoader.THREAD_LOAD_FAILED, ResourceLoader.THREAD_LOAD_INVALID_RESOURCE]:
				if status == ResourceLoader.THREAD_LOAD_FAILED: ResourceLoader.load_threaded_get(entry.path)
				_raw_request(entry)
		elif entry.phase == "raw" and WorkerThreadPool.is_task_completed(entry.task):
			WorkerThreadPool.wait_for_task_completion(entry.task)
			if entry.job.image != null:
				result = ImageTexture.create_from_image(entry.job.image)
				raw_loads += 1
			done = true
		if done:
			_textures[key] = result
			if result == null: _warn_once(entry.id)
			_pending.erase(key)
			upload_serial += 1
		load_operation_max_usec = maxi(load_operation_max_usec, Time.get_ticks_usec()-op)
	load_frame_max_usec = maxi(load_frame_max_usec, Time.get_ticks_usec()-began)

static func shutdown_loading() -> void:
	for entry: Dictionary in _pending.values():
		if entry.phase == "imported": ResourceLoader.load_threaded_get(entry.path)
		elif entry.phase == "raw": WorkerThreadPool.wait_for_task_completion(entry.task)
	_pending.clear()
	_requests.clear()
	_prewarm_started = false

static func enabled() -> bool:
	if DisplayServer.get_name() == "headless": return false
	return selected_set() == "sprites"

static func selected_set() -> String:
	if not mode_override.is_empty(): return mode_override
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--art-set="):
			return "shapes" if arg.get_slice("=", 1) == "shapes" else "sprites"
	return "sprites"

static func metadata() -> Dictionary:
	if not _metadata_checked:
		_metadata_checked = true
		var path := "res://assets/art/manifest.json"
		if FileAccess.file_exists(path):
			var value = JSON.parse_string(FileAccess.get_file_as_string(path))
			if value is Dictionary: _metadata = value.get("sheets", {})
		if _metadata.is_empty(): _warn_once("manifest")
	return _metadata

static func description(kind: String, state: String) -> Dictionary:
	return metadata().get(kind + "/" + state, {})

static func _warn_once(id: String) -> void:
	if _warnings.has(id): return
	_warnings[id] = true
	push_warning("Sprite art unavailable; using shapes for " + id)

static func texture(id: String, path: String) -> Texture2D:
	# Keep this guard BEFORE file existence checks, reads and texture construction.
	if not enabled(): return null
	var resolved: String = path_overrides.get(id, path)
	var key := id + "|" + resolved
	if _textures.has(key): return _textures[key]
	_request(id, resolved)
	return null

static func frame_index(desc: Dictionary, seconds: float) -> int:
	var frame := maxi(0, floori(seconds * float(desc.fps)))
	return frame % int(desc.frames) if desc.loop else mini(frame, int(desc.frames) - 1)

static func draw_frame(canvas: CanvasItem, kind: String, state: String, polarity: int,
		seconds: float, foot: Vector2, facing: int, tint: Color = Color.WHITE) -> bool:
	if not enabled(): return false
	var desc := description(kind, state)
	if desc.is_empty(): return false
	canvas.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	var path: String = desc.path.replace("{color}", "blue" if polarity == 0 else "orange")
	var sheet := texture(path, path)
	if sheet == null: return false
	var size := Vector2(desc.cell[0], desc.cell[1])
	var pivot := Vector2(desc.pivot[0], desc.pivot[1])
	var dest := Rect2(foot - pivot, size)
	if facing < 0:
		# CanvasItem treats a negative width as a flip at the SAME top-left.
		dest.position.x = foot.x - size.x + pivot.x
		dest.size.x = -size.x
	canvas.draw_texture_rect_region(sheet, dest,
		Rect2(Vector2(frame_index(desc, seconds), desc.row) * size, size), tint)
	return true

static func actor_state(actor: CharacterBody2D) -> String:
	if actor.dead: return "death"
	if actor.hit_flash > 0: return "hurt"
	if actor.kind == "player":
		if actor.art_switch_remaining > 0: return "switch"
		if actor.dash_remaining > 0: return "dash"
		if actor.gliding: return "glide"
		if actor.art_land_remaining > 0: return "land"
		if not actor.is_on_floor():
			if actor.is_on_wall(): return "wall"
			return "jump" if actor.velocity.y < 0 else "fall"
		return "run" if absf(actor.velocity.x) > 10 else "idle"
	if actor.action == "windup_switch": return "windup_switch"
	if actor.kind == "boss" and actor.action == "windup_special": return "windup_special"
	if actor.art_switch_remaining > 0: return "switch"
	if actor.action.begins_with("windup"): return "windup"
	if actor.art_fire_remaining > 0: return "fire_special" if actor.kind == "boss" and actor.art_special_fire else "fire"
	if actor.action == "firing_laser": return "fire"
	return "move" if actor.kind == "flyer" or absf(actor.velocity.x) > 5 else "idle"

static func actor_kind(actor: CharacterBody2D) -> String:
	return actor.boss_role if actor.kind == "boss" else actor.kind

static func draw_actor(actor: CharacterBody2D) -> bool:
	var kind := actor_kind(actor)
	if not enabled() or not STATES.has(kind): return false
	var state := actor_state(actor)
	var flash := Color(2.5,2.5,2.5) if actor.hit_flash > 0 else Color.WHITE
	if actor.art_state != state:
		actor.art_state = state
		actor.art_time = 0.0
	# Verify both layers before drawing either, so a missing arm falls back cleanly.
	if actor.kind == "player":
		var arm_state: String = state
		var shooting: bool = actor.art_fire_remaining > 0 and state not in ["death", "hurt"]
		if shooting: arm_state = ["shoot_front", "shoot_up", "shoot_down"][actor.aim_index]
		for id in ["player", "player_arm"]:
			var info := description(id, state if id == "player" else arm_state)
			if info.is_empty(): return false
			var path: String = info.path.replace("{color}", "blue" if actor.polarity == 0 else "orange")
			if texture(path, path) == null: return false
		actor.draw_set_transform(Vector2(0, actor.body_size.y / 2 * (1.0 - actor.visual_scale.y)), 0, actor.visual_scale)
		var foot := Vector2(0, actor.body_size.y / 2)
		draw_frame(actor, "player", state, actor.polarity, actor.art_time, foot, actor.facing, flash)
		draw_frame(actor, "player_arm", arm_state, actor.polarity,
			0.125 - actor.art_fire_remaining if shooting else actor.art_time, foot, actor.facing, flash)
		actor.draw_set_transform(Vector2.ZERO)
		return true
	# A switch sheet is keyed by CURRENT color and swaps its crown/core toward
	# the opposite color. Once changed, use the previous color's baked transition.
	var color: int = 1-actor.polarity if state == "switch" else actor.polarity
	return draw_frame(actor, kind, state, color, actor.art_time,
		Vector2(0, actor.body_size.y / 2), actor.facing, flash)

static func cell_hash(cell: Vector2i, seed_value: int) -> int:
	var h := ((cell.x * 73856093) ^ (cell.y * 19349663) ^ (seed_value * 83492791)) & 0x7fffffff
	h ^= h >> 15
	h = (h * 1103515245) & 0x7fffffff
	h ^= h >> 13
	return h

static func waterway(terrain: Node2D, point: Vector2) -> bool:
	return terrain_region(terrain, point) == 0

static func terrain_region(terrain: Node2D, point: Vector2) -> int:
	var coord := Vector2i((point / preload("res://scripts/tuning.gd").SECTOR_SIZE).floor())
	coord += terrain.stage.get("origin_sector", Vector2i.ZERO)
	return preload("res://scripts/sector_generator.gd").region_at(int(terrain.stage.get("seed", 0)), coord)

static func terrain_path(region: int, special: bool = false) -> String:
	if special: return "res://assets/art/terrain/" + ["special.png", "special-crystal.png", "special-ash.png"][clampi(region,0,2)]
	return "res://assets/art/terrain/" + ["waterway.png", "crystal.png", "ash.png"][clampi(region,0,2)]

static func tile_visual_region(cell: Vector2i, seed_value: int) -> int:
	# Absolute integer cells only: no float world position or moving origin.
	var extent := Vector2i(preload("res://scripts/tuning.gd").SECTOR_SIZE / 32)
	var sector := Vector2i.ZERO
	var local := Vector2i.ZERO
	for axis in range(2):
		@warning_ignore("integer_division")
		sector[axis] = cell[axis] / extent[axis]
		if cell[axis] < 0 and cell[axis] % extent[axis] != 0: sector[axis] -= 1
		local[axis] = cell[axis] - sector[axis] * extent[axis]
	var selected := sector
	for axis in range(2):
		var distance := mini(local[axis], extent[axis]-1-local[axis])
		if distance >= 2: continue
		# Nearest cell: 3/8 foreign tiles; second cell: 1/8. Axis salts
		# also handle horizontal boundaries and four-sector corners.
		if cell_hash(cell, seed_value + 7919 + axis*104729) % 8 < (3 if distance==0 else 1):
			selected[axis] += -1 if local[axis] < 2 else 1
	return preload("res://scripts/sector_generator.gd").region_at(seed_value, selected)

static func draw_tile(canvas: Node2D, terrain: Node2D, cell: Vector2i, mask: int, at: Vector2) -> bool:
	if not enabled(): return false
	var path := terrain_path(tile_visual_region(cell,int(terrain.stage.get("seed",0))),terrain.block_cells.has(cell))
	var sheet := texture(path,path)
	if sheet == null: return false
	var src := Vector2(96,0) if terrain.block_cells.has(cell) else Vector2(mask*32, (cell_hash(cell,int(terrain.stage.get("seed",0))) % 4)*32)
	canvas.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	var tint := Color.WHITE
	# The 8-neighbor mask cannot distinguish deep rock from the first buried
	# row. Inspect the tile above without changing collision/generation data.
	if mask & 1 and not terrain.block_cells.has(cell):
		var above: int = terrain.tile_masks.get(cell+Vector2i(0,-1),255)
		if not above & 1: tint = Color(1.18,1.18,1.16)
	canvas.draw_texture_rect_region(sheet,Rect2(at,Vector2(32,32)),Rect2(src,Vector2(32,32)),tint)
	return true

static func draw_shelf(canvas: Node2D, terrain: Node2D, shelf: Rect2) -> bool:
	if not enabled(): return false
	canvas.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	var x := shelf.position.x
	while x < shelf.end.x:
		var width := minf(32-fposmod(x,32),shelf.end.x-x)
		var cell: Vector2i = terrain.cell_at(Vector2(x,shelf.position.y))
		var seed_value := int(terrain.stage.get("seed",0))
		var path := terrain_path(tile_visual_region(cell,seed_value),true)
		var sheet := texture(path,path)
		var col := cell_hash(cell,seed_value) % 3
		var part := Rect2(Vector2(x,shelf.position.y),Vector2(width,shelf.size.y))
		if sheet == null:
			# A missing regional sheet affects this cell only, even when one
			# continuous shelf crosses several regional texture choices.
			terrain.draw_shelf_shape(canvas,part)
		else:
			canvas.draw_texture_rect_region(sheet,Rect2(part.position-canvas.position,part.size),Rect2(Vector2(col*32+fposmod(x,32),0),part.size))
		x += width
	return true

static func icon(polarity: int) -> Texture2D:
	if not enabled(): return null
	var path := "res://assets/art/hud/colors.png"
	var sheet := texture(path,path)
	if sheet == null: return null
	if _icons.has(polarity): return _icons[polarity]
	var atlas := AtlasTexture.new()
	atlas.atlas = sheet
	atlas.region = Rect2(polarity*32,0,32,32)
	_icons[polarity] = atlas
	return atlas

static func draw_beam(canvas: Node2D, points: PackedVector2Array, phase: String, polarity: int, seconds: float) -> bool:
	if not enabled(): return false
	var desc := description("laser",phase)
	if desc.is_empty(): return false
	var path: String = desc.path.replace("{color}","blue" if polarity == 0 else "orange")
	var sheet := texture(path,path)
	if sheet == null: return false
	canvas.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	var distance := seconds*72
	var column := frame_index(desc,seconds)*64
	for i in range(1,points.size()):
		var start := canvas.to_local(points[i-1])
		var vector := points[i]-points[i-1]
		var offset := 0.0
		while offset < vector.length():
			var source_x := fposmod(distance,64)
			var span := minf(vector.length()-offset,64-source_x)
			canvas.draw_set_transform(start+vector.normalized()*offset,vector.angle())
			canvas.draw_texture_rect_region(sheet,Rect2(0,-12,span+0.5,24),Rect2(column+source_x,desc.row*24,span,24))
			offset += span
			distance += span
	canvas.draw_set_transform(Vector2.ZERO)
	return true

static func spawn_death(actor: CharacterBody2D) -> void:
	if not enabled() or not STATES.has(actor_kind(actor)): return
	if not actor.is_inside_tree() or actor.get_parent() == null: return
	var ghost = load("res://scripts/sprite_death.gd").new()
	ghost.kind = actor_kind(actor)
	ghost.polarity = actor.polarity
	ghost.facing = actor.facing
	ghost.position = actor.position + Vector2(0,actor.body_size.y/2)
	# A sibling in the same world follows pause, reset and origin-shift transforms.
	actor.get_parent().add_child(ghost)
